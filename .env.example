# --- WhatsApp Business API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=       # ID del número en Meta Developers
WHATSAPP_ACCESS_TOKEN=          # Token permanente de usuario del sistema
WHATSAPP_VERIFY_TOKEN=          # Token secreto para verificar webhook
WHATSAPP_APP_SECRET=            # (Opcional, recomendado) App Secret para validar la firma X-Hub-Signature-256

# --- Supabase ---
SUPABASE_URL=                   # URL del proyecto Supabase
SUPABASE_SERVICE_ROLE_KEY=      # Service role key (solo en servidor)
NEXT_PUBLIC_SUPABASE_URL=       # Misma URL (para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Anon key pública

# --- IA ---
OPENROUTER_API_KEY=             # Key de OpenRouter
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# --- Email (Resend) ---
RESEND_API_KEY=                 # Key de Resend
RESEND_FROM="Sara CRM <alertas@tudominio.com>"  # Remitente (dominio verificado en Resend)
NOTIFY_EMAIL=                   # Email(s) para notificaciones, separados por coma

# --- Seguridad / acceso ---
CRON_SECRET=                    # String secreto: protege followup-worker y /api/cron/* (generalo con: openssl rand -hex 32)
ALLOWED_EMAIL_DOMAIN=tudominio.com  # Solo emails @tudominio.com pueden entrar al panel

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # en Netlify: https://tu-sitio.netlify.app
